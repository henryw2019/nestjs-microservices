{
  "devDependencies": {
    "@commitlint/cli": "^18.5.0",
    "@commitlint/config-conventional": "^18.5.0",
    "@commitlint/config-pnpm-scopes": "^18.4.4",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.1",
    "@swc/helpers": "0.5.17",
    "@swc/register": "0.1.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.5",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-turbo": "^2.6.0",
    "eslint-plugin-no-relative-import-paths": "^1.5.5",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.12.0",
    "husky": "^9.1.6",
    "jest": "^30.2.0",
    "lint-staged": "^15.2.10",
    "madge": "8.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3"
  },
  "name": "nestjs-microservices-monorepo",
  "packageManager": "pnpm@10.20.0",
  "private": true,
  "scripts": {
    "build": "turbo run build ",
    "build:swc": "turbo run build:swc",
    "ci": "turbo run lint test build --concurrency=1",
    "ci:swc": "turbo run lint test build:swc --concurrency=1",
    "dev": "turbo run dev",
    "dev:swc": "turbo run dev:swc",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint --concurrency=1",
    "prepare": "husky install",
    "test": "turbo run test --concurrency=1",
    "proto:generate": "turbo run proto:generate",
    "prisma:generate": "turbo run prisma:generate",
    "prisma:migrate": "turbo run prisma:migrate",
    "prisma:migrate:prod": "turbo run prisma:migrate:prod",
    "prisma:studio": "turbo run prisma:studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "nestjs-grpc",
      "prisma",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}