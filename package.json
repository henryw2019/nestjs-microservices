{
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@commitlint/config-pnpm-scopes": "20.1.0",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.1",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.1",
    "@swc/helpers": "0.5.17",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.6.1",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-only-warn": "1.1.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "lint-staged": "16.2.7",
    "madge": "8.0.0",
    "prettier": "3.6.2",
    "rimraf": "6.1.2",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.6.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "prisma": "6.19.0",
    "@prisma/client": "6.19.0"
  },
  "name": "nestjs-microservices-monorepo",
  "packageManager": "pnpm@10.20.0",
  "private": true,
  "scripts": {
    "build": "turbo run build ",
    "build:swc": "turbo run build:swc",
    "ci": "turbo run lint test build --concurrency=1",
    "ci:swc": "turbo run lint test build:swc --concurrency=1",
    "dev": "turbo run dev",
    "dev:swc": "turbo run dev:swc",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint --concurrency=1",
    "prepare": "husky",
    "test": "turbo run test --concurrency=1",
    "proto:generate": "turbo run proto:generate",
    "prisma:generate": "turbo run prisma:generate",
    "prisma:migrate": "turbo run prisma:migrate",
    "prisma:migrate:prod": "turbo run prisma:migrate:prod",
    "prisma:studio": "turbo run prisma:studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "nestjs-grpc",
      "prisma",
      "protobufjs",
      "unrs-resolver",
      "@swc/core"
    ]
  },
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}