{
  "name": "nestjs-microservices-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.20.0",
  "workspaces": [
    "auth",
    "chain-indexer",
    "chain-reader",
    "chain-service"
  ],
  "devDependencies": {
    "js-yaml": "4.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.6.0"
  },
  "scripts": {
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo prune --scope=. --docker || true"
  }
}