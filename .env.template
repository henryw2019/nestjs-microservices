# =============================================================================
# 环境变量模板 - 统一配置管理
# =============================================================================

# -----------------------------------------------------------------------------
# 全局配置 (Global Configuration)
# -----------------------------------------------------------------------------
NODE_ENV="local"
APP_DEBUG=true
APP_CORS_ORIGINS="*"

# Sentry
SENTRY_DSN=""

# -----------------------------------------------------------------------------
# 数据库配置 (Database Configuration)
# -----------------------------------------------------------------------------
# Auth Service Database
AUTH_DATABASE_URL="postgresql://admin:master123@postgres:5432/postgres?schema=public"

# Indexer Service Database  
INDEXER_DATABASE_URL="postgresql://admin:master123@postgres:5432/postgres?schema=indexer"

# Chain Service Database
CHAIN_SERVICE_DATABASE_URL="postgresql://admin:master123@postgres:5432/postgres?schema=chain_service"

# Chain Reader Read-Only Database
CHAIN_READER_DATABASE_URL="postgresql://admin:master123@postgres:5432/postgres?schema=indexer&connection_limit=5"

# Legacy DATABASE_URL (backwards compatibility)
DATABASE_URL="postgresql://admin:master123@postgres:5432/postgres?schema=public"

# -----------------------------------------------------------------------------
# Redis配置 (Redis Configuration)
# -----------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"
REDIS_TTL=3600

# Service-specific Redis prefixes
REDIS_KEY_PREFIX_AUTH="auth:"
REDIS_KEY_PREFIX_CHAIN_SERVICE="chain-service:"
REDIS_KEY_PREFIX_CHAIN_READER="chain-reader:"

# -----------------------------------------------------------------------------
# JWT认证配置 (JWT Authentication Configuration)
# -----------------------------------------------------------------------------
ACCESS_TOKEN_SECRET_KEY="EAJYjNJUnRGJ6uq1YfGw4NG1pd1z102J"
ACCESS_TOKEN_EXPIRED="1d"
REFRESH_TOKEN_SECRET_KEY="LcnlpiuHIJ6eS51u1mcOdk0P49r2Crwu"
REFRESH_TOKEN_EXPIRED="7d"

# -----------------------------------------------------------------------------
# HTTP服务配置 (HTTP Service Configuration)
# -----------------------------------------------------------------------------
# HTTP通用配置
HTTP_ENABLE=true
HTTP_HOST="::"
HTTP_VERSIONING_ENABLE=true
HTTP_VERSION=1

# Service-specific HTTP ports
HTTP_PORT_AUTH=9001
HTTP_PORT_CHAIN_SERVICE=9003
HTTP_PORT_CHAIN_READER=9004
HTTP_PORT_CHAIN_INDEXER=9200

# -----------------------------------------------------------------------------
# gRPC服务配置 (gRPC Service Configuration)
# -----------------------------------------------------------------------------
# Auth Service (作为gRPC服务器)
GRPC_AUTH_URL="0.0.0.0:50051"
GRPC_AUTH_PACKAGE="auth"

# Auth Service 同时提供 UserService
GRPC_USER_URL="0.0.0.0:50051"
GRPC_USER_PACKAGE="user"

# Chain Reader Service (作为gRPC服务器)
GRPC_CHAIN_READER_URL="0.0.0.0:50054"
GRPC_CHAIN_READER_PACKAGE="chain-reader"

# Chain Service (作为gRPC客户端)
GRPC_CHAIN_SERVICE_URL=""
GRPC_CHAIN_SERVICE_PACKAGE="chain"

# Chain Service 连接外部服务的gRPC配置
# 注意: UserService 实际由 Auth Service 提供，所以 userUrl 指向 auth-service
GRPC_CLIENT_AUTH_URL="auth-service:50051"
GRPC_CLIENT_USER_URL="auth-service:50051"

# Legacy GRPC配置 (backwards compatibility)
GRPC_URL="0.0.0.0:50051"
GRPC_PACKAGE="auth"

# -----------------------------------------------------------------------------
# 区块链配置 (Blockchain Configuration)
# -----------------------------------------------------------------------------
# RPC URLs
ETH_RPC_URL=http://127.0.0.1:8545
ETH_RPC_URL_DOCKER=http://host.docker.internal:8545

# Chain Configuration
CHAIN_ID=23333
POLL_INTERVAL_MS=5000
BATCH_SIZE=5
TRANSACTION_TIMEOUT_MS=600000
CONFIRMATIONS=12
GENESIS_JSON_PATH=./genesis.json

# -----------------------------------------------------------------------------
# 服务特定配置 (Service-specific Configuration)
# -----------------------------------------------------------------------------
# Auth Service
AUTH_APP_NAME="auth"

# Chain Service
CHAIN_SERVICE_APP_NAME="chain-service"

# Chain Reader Service
CHAIN_READER_APP_NAME="chain-reader"
CHAIN_READER_DOC_PREFIX="/docs"
CHAIN_READER_API_VERSION="1.0.0"
CHAIN_READER_CACHE_TTL_SECONDS=3
CHAIN_READER_CACHE_MAX_ITEMS=5000

# Chain Indexer Service
CHAIN_INDEXER_APP_NAME="chain-indexer"

# -----------------------------------------------------------------------------
# 通用应用配置 (General Application Configuration)
# -----------------------------------------------------------------------------
# Documentation
DOC_PREFIX="/docs"
API_VERSION="1.0.0"

# Cache Configuration
CACHE_TTL_SECONDS=3
CACHE_MAX_ITEMS=5000

# Logging
APP_LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# 开发工具配置 (Development Tools Configuration)
# -----------------------------------------------------------------------------
# Private key for contract interactions (开发环境使用)
PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# 部署说明 (Deployment Instructions)
# -----------------------------------------------------------------------------
# 1. 开发环境: 直接使用此文件，根据需要修改具体值
# 2. Docker环境: 使用 docker-compose.yml 挂载此文件
# 3. 生产环境: 复制此文件为 .env.production 并修改敏感信息
# 4. 各服务通过 ConfigModule 加载此文件，使用服务前缀的变量避免冲突