{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2022",
    "loose": false,
    "externalHelpers": true,
    "keepClassNames": true
  },
  "module": {
    "type": "commonjs",
    "strict": true,
    "strictMode": true,
    "lazy": false
  },
  "sourceMaps": true,
  "inlineSourcesContent": true,
  "isModule": true,
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/node_modules/**",
    "**/prisma-client/**",
    "**/*.spec.ts"
  ]
}