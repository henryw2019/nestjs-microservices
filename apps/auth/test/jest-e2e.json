{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["@swc/jest", {
      "jsc": {
        "parser": {
          "syntax": "typescript",
          "decorators": true,
          "dynamicImport": true
        },
        "transform": {
          "legacyDecorator": true,
          "decoratorMetadata": true
        }
      }
    }]
  },
  "moduleNameMapper": {
    "^@faker-js/faker$": "<rootDir>/mocks/faker.mock.ts",
    "^@prisma/client$": "<rootDir>/../prisma-client/client",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}