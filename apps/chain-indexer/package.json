{
  "name": "chain-indexer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:swc": "nest build --webpackPath webpack.config.js",
    "build:prod": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main",
    "start:swc": "node -r @swc-node/register src/main.ts",
    "dev": "dotenv -e ../../.env.docker nest start --watch",
    "dev:swc": "dotenv -e ../../.env.docker nest start --watch --webpackPath webpack.config.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --config test/jest.json --runInBand",
    "proto:generate": "pnpm exec nestjs-grpc generate --proto ./src/protos --output ./src/generated",
    "prisma:migrate": "dotenv -e ../../.env.docker -- prisma migrate dev --schema ../../packages/database/prisma/indexer/schema.prisma",
    "prisma:migrate:prod": "dotenv -e ../../.env.docker -- prisma migrate deploy --schema ../../packages/database/prisma/indexer/schema.prisma",
    "prisma:studio": "dotenv -e ../../.env.docker -- prisma studio --schema ../../packages/database/prisma/indexer/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@repo/base-deps": "workspace:*",
    "@repo/database": "workspace:*",
    "ethers": "6.15.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.8",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.5",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "11.0.0",
    "nestjs-grpc": "1.4.2",
    "prisma": "7.0.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "swc-loader": "0.2.6",
    "ts-loader": "9.5.4"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}