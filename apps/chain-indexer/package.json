{
  "name": "chain-indexer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:swc": "nest build --webpackPath webpack.config.js",
    "build:prod": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main",
    "start:swc": "node -r @swc-node/register src/main.ts",
    "dev": "npm run proto:generate && nest start --watch",
    "dev:swc": "npm run proto:generate && nest start --watch --webpackPath webpack.config.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --config test/jest.json --runInBand",
    "proto:generate": "npx nestjs-grpc generate --proto ./src/protos --output ./src/generated",
    "prisma:generate": "dotenv -e .env.docker -- prisma generate",
    "prisma:migrate": "dotenv -e .env.docker -- prisma migrate dev",
    "prisma:migrate:prod": "dotenv -e .env.docker -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.docker -- prisma studio"
  },
  "dependencies": {
    "@repo/base-deps": "workspace:*",
    "ethers": "^6.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.8",
    "@swc/jest": "0.2.39",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.21.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "swc-loader": "0.2.6",
    "ts-loader": "^9.5.1"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}