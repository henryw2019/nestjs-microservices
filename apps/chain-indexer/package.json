{
  "name": "chain-indexer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "start": "node dist/main.js",
  "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "dev": "dotenv -e .env -- ts-node-dev --respawn --transpile-only src/main.ts",
    "prisma:generate": "dotenv -e .env.docker -- prisma generate",
    "prisma:migrate": "dotenv -e .env.docker -- prisma migrate dev",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@prisma/client": "^5.21.1",
    "ethers": "^6.9.0",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.5",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.21.1",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
