{
    "name": "chain-reader",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:prod": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "dev": "npm run proto:generate && nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --config test/jest.json --runInBand",
    "proto:generate": "npx nestjs-grpc generate --proto ./src/protos --output ./src/generated",
    "prisma:generate": "dotenv -e .env.docker -- prisma generate",
    "prisma:migrate": "dotenv -e .env.docker -- prisma migrate dev",
    "prisma:migrate:prod": "dotenv -e .env.docker -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.docker -- prisma studio",
    "prepare": "husky"
    },
    "dependencies": {
        "@keyv/redis": "^4.4.0",
        "@nestjs/cache-manager": "^3.0.1",
        "@nestjs/common": "^11.1.8",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.8",
        "@nestjs/platform-express": "^11.1.8",
        "@nestjs/swagger": "^11.2.1",
        "@nestjs/terminus": "^11.0.0",
        "@prisma/client": "^5.21.1",
        "cache-manager": "^6.4.3",
        "cacheable": "^1.9.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^16.4.5",
        "express": "^5.1.0",
        "helmet": "^8.0.0",
        "joi": "^17.13.3",
        "nestjs-i18n": "^10.4.9",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.0.0",
        "@eslint/js": "^9.0.0",
        "@nestjs/cli": "^11.0.10",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.8",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.8.5",
        "@types/supertest": "^6.0.2",
        "dotenv-cli": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-no-relative-import-paths": "^1.5.5",
        "eslint-plugin-prettier": "^5.2.1",
        "husky": "^9.1.6",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.10",
        "prettier": "^3.3.3",
        "prisma": "^5.21.1",
        "rimraf": "^6.0.1",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.6.3"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}