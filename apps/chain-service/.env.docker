# Cloud Agent configuration (used when AML_DELEGATION_TYPE=cloud_agent)
AML_CLOUD_AGENT_URL=""
AML_CLOUD_AGENT_API_KEY=""

# Common AML settings
AML_TIMEOUT_MS=15000
AML_RETRY_ATTEMPTS=2
AML_RETRY_DELAY_MS=500
AML_ENFORCEMENT_MODE="block_on_fail"
