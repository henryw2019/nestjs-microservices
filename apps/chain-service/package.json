{
    "name": "chain-service",
    "version": "1.0.0",
    "private": true,
    "description": "Custodial wallet microservice for on-chain transfers and keystore management",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.20.0"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "build:swc": "nest build --webpackPath webpack.config.js",
        "build:prod": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "node dist/main",
        "start:swc": "node -r @swc-node/register src/main.ts",
        "dev": "nest start --watch",
        "dev:swc": "nest start --watch --webpackPath webpack.config.js",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "test": "jest --config test/jest.json --runInBand",
        "proto:generate": "pnpm exec nestjs-grpc generate --proto ./src/protos --output ./src/generated",
        "prisma:generate": "pnpm --filter @repo/database run generate:chain-service",
        "prisma:migrate": "dotenv -e .env.docker -- prisma migrate dev --schema ../../packages/database/prisma/chain-service/schema.prisma",
        "prisma:migrate:prod": "dotenv -e .env.docker -- prisma migrate deploy --schema ../../packages/database/prisma/chain-service/schema.prisma",
        "prisma:studio": "dotenv -e .env.docker -- prisma studio --schema ../../packages/database/prisma/chain-service/schema.prisma"
    },
    "dependencies": {
        "@repo/base-deps": "workspace:*",
        "@repo/database": "workspace:*",
        "@grpc/grpc-js": "1.14.1",
        "@grpc/proto-loader": "0.8.0",
        "@keyv/redis": "5.1.4",
        "@nestjs/jwt": "11.0.1",
        "@nestjs/passport": "11.0.5",
        "@nestjs/schedule": "6.0.1",
        "@sentry/node": "10.25.0",
        "bcryptjs": "3.0.3",
        "ethers": "6.15.0",
        "ioredis": "5.8.2",
        "soap": "1.6.0",
        "passport": "0.7.0",
        "passport-jwt": "4.0.1"
    },
    "devDependencies": {
        "@types/cache-manager-ioredis": "2.0.8",
        "@types/config": "3.3.5",
        "@types/ms": "2.1.0",
        "@types/passport-jwt": "4.0.1",
        "@types/pg": "8.15.6",
        "nestjs-grpc":"1.4.2"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}
