{
    "name": "chain-service",
    "version": "1.0.0",
    "private": true,
    "description": "Custodial wallet microservice for on-chain transfers and keystore management",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.20.0"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "build:swc": "nest build --webpackPath webpack.config.js",
        "build:prod": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "node dist/main",
        "start:swc": "node -r @swc-node/register src/main.ts",
        "dev": "pnpm run proto:generate && nest start --watch",
        "dev:swc": "pnpm run proto:generate && nest start --watch --webpackPath webpack.config.js",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "test": "jest --config test/jest.json --runInBand",
        "proto:generate": "npx nestjs-grpc generate --proto ./src/protos --output ./src/generated",
        "prisma:generate": "dotenv -e .env.docker -- prisma generate",
        "prisma:migrate": "dotenv -e .env.docker -- prisma migrate dev",
        "prisma:migrate:prod": "dotenv -e .env.docker -- prisma migrate deploy",
        "prisma:studio": "dotenv -e .env.docker -- prisma studio"
    },
    "dependencies": {
        "@repo/base-deps": "workspace:*",
        "@grpc/grpc-js": "^1.13.4",
        "@grpc/proto-loader": "^0.7.15",
        "@keyv/redis": "^4.4.0",
        "@nestjs/jwt": "^11.0.1",
        "@nestjs/passport": "^11.0.5",
        "@sentry/node": "^9.26.0",
        "bcryptjs": "3.0.3",
        "ethers": "^6.9.0",
        "ioredis": "^5.6.1",
        "nestjs-grpc": "^1.3.11",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1"
    },
    "devDependencies": {
        "@types/cache-manager-ioredis": "^2.0.7",
        "@types/config": "^3.3.5",

        "@types/ms": "^0.7.34",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.11.10"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}
