{
    "name": "chain-service",
    "version": "1.0.0",
    "private": true,
    "description": "Custodial wallet microservice for on-chain transfers and keystore management",
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "build:prod": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "node dist/main",
        "dev": "npm run proto:generate && nest start --watch",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "test": "jest --config test/jest.json --runInBand",
        "proto:generate": "npx nestjs-grpc generate --proto ./src/protos --output ./src/generated",
        "prisma:generate": "dotenv -e .env.docker -- prisma generate",
        "prisma:migrate": "dotenv -e .env.docker -- prisma migrate dev",
        "prisma:migrate:prod": "dotenv -e .env.docker -- prisma migrate deploy",
        "prisma:studio": "dotenv -e .env.docker -- prisma studio"
    },
    "dependencies": {
        "@faker-js/faker": "^9.1.0",
        "@grpc/grpc-js": "^1.13.4",
        "@grpc/proto-loader": "^0.7.15",
        "@keyv/redis": "^4.4.0",
        "@nestjs/cache-manager": "^3.0.1",
        "@nestjs/common": "^11.1.8",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.8",
        "@nestjs/jwt": "^11.0.1",
        "@nestjs/microservices": "^11.1.8",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.8",
        "@nestjs/swagger": "^11.2.1",
        "@nestjs/terminus": "^11.0.0",
        "@prisma/client": "^5.21.1",
        "@sentry/node": "^9.26.0",
        "bcryptjs": "3.0.3",
        "cache-manager": "^6.4.3",
        "cacheable": "^1.9.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^16.4.5",
        "ethers": "^6.9.0",
        "express": "^5.1.0",
        "helmet": "^8.0.0",
        "ioredis": "^5.6.1",
        "joi": "^17.13.3",
        "nestjs-grpc": "^1.3.11",
        "nestjs-i18n": "^10.4.9",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.10",
        "@nestjs/schematics": "^11.0.9",
        "@nestjs/testing": "^11.1.8",
        "@types/cache-manager-ioredis": "^2.0.7",
        "@types/config": "^3.3.5",
        "@types/express": "^5.0.0",
        "@types/joi": "^17.2.3",
        "@types/mime": "^4.0.0",
        "@types/ms": "^0.7.34",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.11.10",
        "@types/supertest": "^6.0.2",
        "dotenv-cli": "^8.0.0",
        "prisma": "^5.21.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-loader": "^9.5.1"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}