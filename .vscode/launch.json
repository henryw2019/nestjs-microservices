{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Auth",
      "cwd": "${workspaceFolder}/apps/auth",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "debug"
      ],
      "console": "integratedTerminal",
      "restart": true,
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Auth (SWC)",
      "cwd": "${workspaceFolder}/apps/auth",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "debug:swc"
      ],
      "console": "integratedTerminal",
      "restart": true,
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Chain Indexer",
