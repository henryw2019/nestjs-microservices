# 强制使用pnpm作为包管理器
package-manager-strict=true

# 设置pnpm存储目录
store-dir=~/.pnpm-store

# 启用副作用缓存，加快安装速度
side-effects-cache=true
# CI 常用：只读使用缓存，避免写入
# side-effects-cache-readonly=true

# 严格对等依赖
strict-peer-dependencies=true

# 自动安装对等依赖
auto-install-peers=true

# 使用扁平化node_modules结构
shamefully-hoist=true