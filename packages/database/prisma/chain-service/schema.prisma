generator client {
  provider = "prisma-client"
  output   = "../../src/generated/chain-service-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model KeyStore {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  address    String   @unique
  privateKey String   @map("privateKey")
  accountName String?  @map("account_name")
  createdAt  DateTime @default(now()) @map("createdAt")

  @@map("keystore")
}

model Contract {
  id        String   @id @default(uuid())
  name      String
  address   String
  abiFile   String   @map("abi_file")
  ownerId   String?  @map("owner_id")
  createdAt DateTime @default(now())

  @@map("contracts")
}

// Anti-Money-Laundering (AML) scan records for audit & enforcement
enum AmlScanStatus {
  PENDING
  PASSED
  REVIEW
  FAILED
  ERROR
}

model AmlScan {
  id                   String        @id @default(uuid())
  // business linkage (optional): tx hash once available
  txHash               String?       @map("tx_hash")
  // who/what we scanned
  fromUserId           String        @map("from_user_id")
  toUserId             String        @map("to_user_id")
  fromAddress          String        @map("from_address")
  toAddress            String        @map("to_address")
  
  // result
  status               AmlScanStatus
  riskScore            Float?        @map("risk_score")
  details              Json?         // full JSON response from AML provider
  
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@map("aml_scans")
}

enum OrderType {
  SUBSCRIPTION // User buys Stablecoin with Fiat
  REDEMPTION   // User sells Stablecoin for Fiat
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model StablecoinOrder {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  
  type      OrderType
  status    OrderStatus @default(PENDING)
  
  // Amount in stablecoin units (raw value, e.g. wei)
  amount    Decimal     @db.Decimal(78, 0) 
  
  // The stablecoin contract address
  currencyContractAddress String @map("currency_contract_address")
  
  // Blockchain Transaction Hash
  // Subscription: Admin -> User
  // Redemption: User (Hosted) -> Issuer
  txHash    String?     @map("tx_hash")
  
  // Addresses
  // Subscription: The user's address receiving the tokens
  // Redemption: The user's hosted address sending the tokens
  walletAddress        String @map("wallet_address")

  // Redemption: The issuer's address receiving the tokens
  toAddress            String? @map("to_address")

  // Redemption: Bank details for receiving fiat
  bankName          String? @map("bank_name")
  accountName       String? @map("account_name")
  accountNumber     String? @map("account_number")
  
  // Financials & Audit
  fee               Decimal? @default(0) @db.Decimal(78, 0)
  exchangeRate      Decimal? @map("exchange_rate") @db.Decimal(36, 18)
  network           String?  @default("ethereum") // e.g. "ethereum", "sepolia"
  remark            String?  // Admin notes or error reasons
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stablecoin_orders")
}
