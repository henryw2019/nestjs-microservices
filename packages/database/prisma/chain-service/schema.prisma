generator client {
  provider = "prisma-client"
  output   = "../../src/generated/chain-service-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// 1. 使用枚举表示密钥类型
enum KeyType {
  SELF_CUSTODY // 用户自管
  HOSTED       // 平台托管
  MPC          // 多方计算
}

model KeyStore {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  // 允许同一地址在不同链上存在记录
  address     String   @map("address") // 公钥/地址    
  // 使用枚举
  keyType     KeyType   @default(HOSTED) @map("key_type") 
  
  // 开发阶段明文存储，方便测试
  privateKey String? @map("private_key") 
  
  accountName String?   @map("account_name")
  
  network     String?   @map("network") // e.g. "ethereum", "bitcoin"
  chainId     Int?      @map("chain_id") // e.g. 1
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([userId])
  
  // 同一用户同一网络下的同一地址只能存在一条记录
  @@unique([userId, address, chainId], map: "unique_address_per_chain")

  @@map("keystore")
}

model Contract {
  id        String   @id @default(uuid())
  name      String
  address   String
  abiFile   String   @map("abi_file")
  ownerId   String?  @map("owner_id")
  createdAt DateTime @default(now())

  @@map("contracts")
}

// Anti-Money-Laundering (AML) scan records for audit & enforcement
enum AmlScanStatus {
  PENDING
  PASSED
  REVIEW
  FAILED
  ERROR
}

model AmlScan {
  id                   String        @id @default(uuid())
  // business linkage (optional): tx hash once available
  txHash               String?       @map("tx_hash")
  // who/what we scanned
  fromUserId           String        @map("from_user_id")
  toUserId             String        @map("to_user_id")
  fromAddress          String        @map("from_address")
  toAddress            String        @map("to_address")
  
  // result
  status               AmlScanStatus
  riskScore            Float?        @map("risk_score")
  details              Json?         // full JSON response from AML provider
  
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@map("aml_scans")
}

enum OrderType {
  SUBSCRIPTION // User buys Stablecoin with Fiat
  REDEMPTION   // User sells Stablecoin for Fiat
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model StablecoinOrder {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  
  type      OrderType
  status    OrderStatus @default(PENDING)
  
  // Amount in stablecoin units (raw value, e.g. wei)
  amount    Decimal     @db.Decimal(78, 0) 
  
  // The stablecoin contract address
  currencyContractAddress String @map("currency_contract_address")
  
  // Blockchain Transaction Hash
  // Subscription: Admin -> User
  // Redemption: User (Hosted) -> Issuer
  txHash    String?     @map("tx_hash")
  
  // Addresses
  // Subscription: The user's address receiving the tokens
  // Redemption: The user's hosted address sending the tokens
  walletAddress        String @map("wallet_address")

  // Redemption: The issuer's address receiving the tokens
  toAddress            String? @map("to_address")

  // Redemption: Bank details for receiving fiat
  bankName          String? @map("bank_name")
  accountName       String? @map("account_name")
  accountNumber     String? @map("account_number")
  
  // Financials & Audit
  fee               Decimal? @default(0) @db.Decimal(78, 0)
  exchangeRate      Decimal? @map("exchange_rate") @db.Decimal(36, 18)
  network           String?  @default("ethereum") // e.g. "ethereum", "sepolia"
  remark            String?  // Admin notes or error reasons
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stablecoin_orders")
}

enum OfflineTransactionStatus {
  CREATED
  SUBMITTED
  CONFIRMED
  EXPIRED
  FAILED
}

model OfflineTransaction {
  id                   String                   @id @default(uuid())
  transactionId        String                   @unique @map("transaction_id")
  userId               String                   @map("user_id")
  
  from                 String
  to                   String
  value                Decimal                  @db.Decimal(78, 0)
  data                 String?
  nonce                Int
  chainId              Int                      @map("chain_id")
  gasLimit             Decimal                  @map("gas_limit") @db.Decimal(78, 0)
  gasPrice             Decimal?                 @map("gas_price") @db.Decimal(78, 0)
  maxFeePerGas         Decimal?                 @map("max_fee_per_gas") @db.Decimal(78, 0)
  maxPriorityFeePerGas Decimal?                 @map("max_priority_fee_per_gas") @db.Decimal(78, 0)
  token                String?                  // ERC20 token address if applicable
  
  status               OfflineTransactionStatus @default(CREATED)
  signedTx             String?                  @map("signed_tx")
  txHash               String?                  @unique @map("tx_hash")
  expiresAt            DateTime                 @map("expires_at")
  
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([expiresAt])
  @@index([from, nonce])
  @@map("offline_transactions")
}
