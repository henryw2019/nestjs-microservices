{
  "name": "@repo/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./indexer": {
      "types": "./dist/indexer.d.ts",
      "default": "./dist/indexer.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./chain-service": {
      "types": "./dist/chain-service.d.ts",
      "default": "./dist/chain-service.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prisma:generate": "pnpm run generate",
    "generate": "pnpm run generate:indexer && pnpm run generate:auth && pnpm run generate:chain-service",
    "generate:indexer": "dotenv -e ../../.env.docker -- prisma generate --config=./prisma/indexer/prisma.config.ts",
    "generate:auth": "dotenv -e ../../.env.docker -- prisma generate --config=./prisma/auth/prisma.config.ts",
    "generate:chain-service": "dotenv -e ../../.env.docker -- prisma generate --config=./prisma/chain-service/prisma.config.ts"
  },
  "dependencies": {
    "@prisma/client": "7.0.0",
    "@prisma/client-runtime-utils": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "dotenv-cli": "11.0.0",
    "prisma": "7.0.0",
    "typescript": "^5.7.3"
  }
}
