{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS",
  "extends": "./base.json",
  "compilerOptions": {
  "module": "Node16",
  "moduleResolution": "Node16",
  "target": "ES2022",
  "lib": ["ES2022"],
  "emitDecoratorMetadata": true,
  "experimentalDecorators": true,
  "sourceMap": true,
  "outDir": "dist",
  "baseUrl": "./",
  "incremental": true,
  "skipLibCheck": true,
  "strict": true,
  "noEmit": false,
  "allowImportingTsExtensions": false
  }
}
