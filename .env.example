# Database URLs for all services
INDEXER_DATABASE_URL="postgresql://admin:password@localhost:5432/postgres?schema=indexer"
AUTH_DATABASE_URL="postgresql://admin:password@localhost:5432/postgres?schema=public"
CHAIN_SERVICE_DATABASE_URL="postgresql://admin:password@localhost:5432/postgres?schema=chain-service"

# Default DATABASE_URL for backwards compatibility
DATABASE_URL="postgresql://admin:password@localhost:5432/postgres?schema=public"

# Redis configuration
REDIS_URL="redis://localhost:6379"

# JWT configuration
ACCESS_TOKEN_SECRET_KEY="your-access-token-secret-key"
ACCESS_TOKEN_EXPIRED="1d"
REFRESH_TOKEN_SECRET_KEY="your-refresh-token-secret-key"
REFRESH_TOKEN_EXPIRED="7d"

# gRPC configuration
GRPC_URL="0.0.0.0:50051"

# Application configuration
NODE_ENV="development"
APP_NAME="nestjs-microservices"
APP_CORS_ORIGINS="*"
APP_DEBUG=true

# HTTP configuration
HTTP_ENABLE=true
HTTP_HOST="::"
HTTP_PORT=9001
HTTP_VERSIONING_ENABLE=true
HTTP_VERSION=1

# Blockchain configuration
ETH_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=23333
POLL_INTERVAL_MS=5000
BATCH_SIZE=5
TRANSACTION_TIMEOUT_MS=600000
CONFIRMATIONS=12
GENESIS_JSON_PATH=./genesis.json

# Sentry
SENTRY_DSN=""