# Build dependencies cache image for offline use
# Usage: docker build -f Dockerfile.deps -t myapp-deps-cache:latest .
# NOTE: Must use the same base OS (Alpine) as the runtime image to ensure binary compatibility (e.g. Prisma engines)
FROM node:22-alpine AS deps-cache
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Install pnpm and system deps needed for some native builds
RUN sed -i 's|https://dl-cdn.alpinelinux.org|https://mirrors.aliyun.com|g' /etc/apk/repositories && \
    apk add --no-cache libc6-compat openssl ca-certificates python3 git && \
    npm config set registry https://mirrors.cloud.tencent.com/npm/ && \
    npm install -g pnpm@latest-10

WORKDIR /app

# 强制指定 store 目录，覆盖 .npmrc 中的设置
ENV NPM_CONFIG_STORE_DIR="/pnpm/pnpm-store"

# Copy workspace configuration and .npmrc
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/auth/package.json ./apps/auth/
COPY apps/chain-reader/package.json ./apps/chain-reader/
COPY apps/chain-service/package.json ./apps/chain-service/
COPY apps/chain-indexer/package.json ./apps/chain-indexer/
COPY packages/base-deps/package.json ./packages/base-deps/
COPY packages/database/package.json ./packages/database/
COPY packages/prettier-config/package.json ./packages/prettier-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/database/prisma ./packages/database/prisma/
COPY package.json turbo.json ./

# Download all dependencies and cache them
# 注意：这里不需要再手动 config set store-dir，因为环境变量 NPM_CONFIG_STORE_DIR 已经生效
# --prod=false: 确保下载所有依赖（包括 devDependencies）
# 执行一次完整的 install，确保所有 postinstall 脚本（如 Prisma 引擎下载）都执行过
# 虽然 postinstall 下载的文件不一定进 store，但 @prisma/engines 包本身会进 store
RUN pnpm install --prod=false && \
    pnpm prisma:generate

# Package the store
RUN tar -czf /pnpm-store.tar.gz -C /pnpm pnpm-store

# Create a minimal image with the tarball
FROM alpine:latest
COPY --from=deps-cache /pnpm-store.tar.gz /pnpm-store.tar.gz

# Default command to hint usage
CMD ["echo", "Container created. Use 'docker cp <container_id>:/pnpm-store.tar.gz .' to extract."]