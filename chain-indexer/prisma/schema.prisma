generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Block {
  number     BigInt  @id
  hash       String
  timestamp  DateTime
}

model Tx {
    hash          String  @id
    blockNumber   BigInt
    from          String
    to            String?
    value         Decimal
    gasUsed       BigInt?
    gasFee        Decimal?  // 实际消耗的ETH，单位wei
    balanceAfter  Decimal?  // from地址交易后ETH余额，单位wei
    nonce         Int?
    input         String?
    status        Int?
    timestamp     DateTime? // 区块链原始时间
}

model ERC20Transfer {
  id          BigInt  @id @default(autoincrement())
  txHash      String
  logIndex    Int
  blockNumber BigInt
  token       String
  from        String
  to          String
  value       Decimal
  timestamp   DateTime? // 发生时的链上时间
}

model EventLog {
  id              BigInt  @id @default(autoincrement())
  chainId         Int
  blockNumber     BigInt
  blockHash       String
  txHash          String
  logIndex        Int
  contractAddress String
  eventName       String
  eventSignature  String
  indexedArgs     Json
  dataArgs        Json
  raw             Json
  processed       Boolean @default(false)
  timestamp       DateTime? // 事件发生时的链上时间
}

model AddressBalance {
  id              BigInt  @id @default(autoincrement())
  address         String
  tokenAddress    String?
  balance         Decimal
  lastUpdatedAt   DateTime @default(now())
}

model TokenMeta {
  tokenAddress String   @id
  name         String?
  symbol       String?
  decimals     Int?
  totalSupply  Decimal? @db.Decimal(78,0)
  lastUpdatedAt DateTime @default(now())
}

model Checkpoint {
  id                Int    @id @default(1)
  chainId           Int
  lastProcessedBlock BigInt
}
